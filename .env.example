# ==============================================================================
# Cybrom Course Advisor Chatbot — Environment Configuration Example
# ==============================================================================

# LLM / Groq Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Database Configuration (PostgreSQL)
# Note: For Render external connection, append '?sslmode=require' if needed
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis (Optional — if set, Redis is used for sessions instead of DB/memory)
REDIS_URL=

# Course Catalog File Path (relative or absolute)
COURSES_FILE=data/courses_data.xlsx
COURSE_PAGE_BASE_URL=https://cybrom.com/courses

# Chatbot Session Settings
MAX_HISTORY_MESSAGES=20
SESSION_EXPIRY_HOURS=24
LEAD_CAPTURE_TIMING=early

# Notifications: CallMeBot WhatsApp Integration
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# Notifications: CRM Webhook Integration (Optional)
CRM_WEBHOOK_URL=

# Mode & Security
TEST_MODE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_secure_password
ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60

# Data Retention (Days to keep leads before cleanup)
DATA_RETENTION_DAYS=90
